GROQ_API_KEY=
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
CORS_ORIGINS=http://localhost:3000
# Set true when served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Refresh tokens remain HttpOnly and are rotated before each ID token expires.
SESSION_REFRESH_COOKIE_NAME=pdf_chatter_session_refresh
SESSION_REFRESH_COOKIE_MAX_AGE_SECONDS=31536000
